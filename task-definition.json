{
  "family": "gha-demo-task",
  "networkMode": "bridge",
  "requiresCompatibilities": ["EC2"],
  "cpu": "256",
  "memory": "256",
  "executionRoleArn": "arn:aws:iam::943264968939:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "PLACEHOLDER_IMAGE",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "hostPort": 0, "protocol": "tcp" }
      ]
    }
  ]
}
